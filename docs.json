{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Domainer Engine",
  "description": "Documentation for Domainer Engine — a ready-to-deploy domain portfolio marketplace built on Next.js and Payload CMS.",
  "colors": {
    "primary": "#1A1A2E",
    "light": "#6366F1",
    "dark": "#1A1A2E"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "CodeCanyon",
      "href": "https://codecanyon.net"
    }
  },
  "footer": {
    "socials": {}
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Changelog",
          "icon": "scroll-text",
          "href": "/changelog"
        },
        {
          "anchor": "Support",
          "icon": "life-buoy",
          "href": "/support"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "pages": [
          "getting-started/introduction",
          "getting-started/requirements",
          "getting-started/deploy-vercel",
          "getting-started/deploy-docker",
          "getting-started/deploy-zip",
          "getting-started/basic-setup",
          "getting-started/update"
        ]
      },
      {
        "group": "Concepts",
        "icon": "book-open",
        "pages": [
          "concepts/domains",
          "concepts/categories",
          "concepts/sale-models",
          "concepts/tags",
          "concepts/admin-panel"
        ]
      },
      {
        "group": "Configuration",
        "icon": "settings",
        "pages": [
          "configuration/general-settings",
          "configuration/appearance-settings",
          "configuration/ai-settings",
          "configuration/ai-prompts",
          "configuration/notification-settings",
          "configuration/storage-settings",
          "configuration/seo-settings",
          "configuration/analytics-settings"
        ]
      },
      {
        "group": "Domains",
        "icon": "globe",
        "pages": [
          "domains/adding-domains",
          "domains/bulk-import",
          "domains/export"
        ]
      },
      {
        "group": "Content",
        "icon": "layout-panel-top",
        "pages": [
          "content/pages",
          "content/page-builder",
          "content/templates",
          "content/blog",
          "content/navigation"
        ]
      },
      {
        "group": "Transactions",
        "icon": "handshake",
        "pages": [
          "transactions/inquiries",
          "transactions/offers",
          "transactions/orders"
        ]
      }
    ]
  }
}
